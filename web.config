<?xml version="1.0" encoding="utf-8"?>
<!-- the root web configuration file -->
<configuration>
  <system.web>
    <compilation tempDirectory="C:\Inetpub\vhosts\just-m.net\tmp"/>
    <sessionState timeout="200"/>
  </system.web>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="AddTrailingSlashRule" stopProcessing="true">
          <match url="(.*[^/])$"/>
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true"/>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true"/>
          </conditions>
          <action type="Redirect" url="{R:1}/"/>
        </rule>
        <rule name="hide php extension" stopProcessing="true">
          <match url="^(.*)/$"/>
          <conditions logicalGrouping="MatchAll">
            <!-- لو مش ملف -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true"/>
            <!-- لو مش فولدر -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true"/>
            <!-- استثناء كل الملفات -->
            <add input="{REQUEST_URI}" pattern="\.(js|css|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|json|map)$" negate="true"/>
          </conditions>
          <action type="Rewrite" url="{R:1}.php"/>
        </rule>
      </rules>
    </rewrite>
    <!-- إضافة إعدادات الضغط Brotli و Gzip -->
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="br" dll="%Windir%\system32\inetsrv\brotli.dll"/>
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll"/>
      <dynamicTypes>
        <add mimeType="application/json" enabled="true"/>
        <add mimeType="text/*" enabled="true"/>
        <add mimeType="application/javascript" enabled="true"/>
        <add mimeType="*/*" enabled="false"/>
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*" enabled="true"/>
        <add mimeType="application/javascript" enabled="true"/>
        <add mimeType="application/json" enabled="true"/>
        <add mimeType="*/*" enabled="false"/>
      </staticTypes>
    </httpCompression>
    <!-- تمكين ضغط URLs -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true"/>
    <!-- إعدادات الأخطاء المخصصة -->
    <httpErrors>
      <remove statusCode="400"/>
      <error statusCode="400" path="C:\Inetpub\vhosts\just-m.net\error_docs\bad_request.html"/>
      <remove statusCode="401"/>
      <error statusCode="401" path="C:\Inetpub\vhosts\just-m.net\error_docs\unauthorized.html"/>
      <remove statusCode="403"/>
      <error statusCode="403" path="C:\Inetpub\vhosts\just-m.net\error_docs\forbidden.html"/>
      <remove statusCode="404"/>
      <error statusCode="404" path="C:\Inetpub\vhosts\just-m.net\error_docs\not_found.html"/>
      <remove statusCode="405"/>
      <error statusCode="405" path="C:\Inetpub\vhosts\just-m.net\error_docs\method_not_allowed.html"/>
      <remove statusCode="406"/>
      <error statusCode="406" path="C:\Inetpub\vhosts\just-m.net\error_docs\not_acceptable.html"/>
      <remove statusCode="407"/>
      <error statusCode="407" path="C:\Inetpub\vhosts\just-m.net\error_docs\proxy_authentication_required.html"/>
      <remove statusCode="412"/>
      <error statusCode="412" path="C:\Inetpub\vhosts\just-m.net\error_docs\precondition_failed.html"/>
      <remove statusCode="414"/>
      <error statusCode="414" path="C:\Inetpub\vhosts\just-m.net\error_docs\request-uri_too_long.html"/>
      <remove statusCode="415"/>
      <error statusCode="415" path="C:\Inetpub\vhosts\just-m.net\error_docs\unsupported_media_type.html"/>
      <remove statusCode="500"/>
      <error statusCode="500" path="C:\Inetpub\vhosts\just-m.net\error_docs\internal_server_error.html"/>
      <remove statusCode="501"/>
      <error statusCode="501" path="C:\Inetpub\vhosts\just-m.net\error_docs\not_implemented.html"/>
      <remove statusCode="502"/>
      <error statusCode="502" path="C:\Inetpub\vhosts\just-m.net\error_docs\bad_gateway.html"/>
      <remove statusCode="503"/>
      <error statusCode="503" path="C:\Inetpub\vhosts\just-m.net\error_docs\maintenance.html"/>
    </httpErrors>
    <!-- تمكين تتبع الأخطاء -->
    <tracing>
      <traceFailedRequests>
        <clear/>
      </traceFailedRequests>
    </tracing>
  </system.webServer>
</configuration>
